# --- Supabase (required) ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Never expose to the browser. Used for admin writes/uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Met Scents"

# --- Owner contact fallback ---
# First-run fallback only — once /admin/settings is saved once, the database
# (settings table) becomes the source of truth and these are ignored.
NEXT_PUBLIC_OWNER_WHATSAPP=233240000000
OWNER_NOTIFICATION_EMAIL=owner@example.com

# --- Email notifications (optional, Resend) ---
# Leave blank to disable email notifications — WhatsApp + the admin dashboard still work.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Met Scents <enquiries@yourdomain.com>"

# --- WhatsApp Business API (optional — automatic owner notifications) ---
# SERVER ONLY, never exposed to the browser. Without these, the site still
# works fully via the customer-initiated "Send on WhatsApp" button, which
# needs no setup at all. Add these only if you want the site itself to also
# push a WhatsApp message to the owner automatically. See README for setup.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
