# --- Supabase (required) ---
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key — SERVER ONLY. Never expose to the browser. Used for admin writes/uploads.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Met Scents"

# --- Owner contact fallback ---
# First-run fallback only — once /admin/settings is saved once, the database
# (settings table) becomes the source of truth and these are ignored.
NEXT_PUBLIC_OWNER_WHATSAPP=233240000000
OWNER_NOTIFICATION_EMAIL=owner@example.com

# --- Email notifications (optional, Resend) ---
# Leave blank to disable email notifications — WhatsApp + the admin dashboard still work.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Met Scents <enquiries@yourdomain.com>"

# WhatsApp is click-to-chat only (no API, token, or webhook needed) — the
# shop's number is set from /admin/settings, not an environment variable.
